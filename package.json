{
  "name": "ai-video-factory",
  "version": "1.0.0",
  "description": "Topic in, finished captioned video out: LLM script, neural TTS with word timings, designed visuals, ffmpeg render for Shorts and YouTube.",
  "license": "MIT",
  "author": "Cuong Nguyen",
  "type": "module",
  "bin": {
    "avf": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "avf": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "youtube",
    "shorts",
    "tts",
    "kokoro",
    "ffmpeg",
    "automation",
    "ai-video"
  ],
  "dependencies": {
    "commander": "^15.1.0",
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "lucide-static": "^1.76.0",
    "onnxruntime-node": "^1.31.1",
    "phonemizer": "^1.2.1",
    "playwright": "1.63.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
